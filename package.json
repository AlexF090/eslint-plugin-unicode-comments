{
  "name": "eslint-plugin-unicode-comments",
  "version": "2.1.1",
  "description": "ESLint plugin flagging dangerous Unicode characters (Trojan Source, homograph attacks) and typographic tells of unedited AI-generated code (em dashes, curly quotes, ellipsis, non-breaking spaces)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "unicode",
    "security",
    "trojan-source",
    "homograph-attack"
  ],
  "author": "AlexF090",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexF090/eslint-plugin-unicode-comments.git"
  },
  "bugs": {
    "url": "https://github.com/AlexF090/eslint-plugin-unicode-comments/issues"
  },
  "homepage": "https://github.com/AlexF090/eslint-plugin-unicode-comments#readme",
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/eslint": "9.6.1",
    "@types/node": "26.1.2",
    "@typescript-eslint/parser": "8.66.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-regexp": "3.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
