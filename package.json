{
  "name": "eslint-plugin-unicode-comments",
  "version": "2.0.1",
  "description": "ESLint plugin for Unicode security checks to prevent various Unicode-based attacks",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslint-plugin",
    "unicode",
    "security",
    "trojan-source",
    "homograph-attack"
  ],
  "author": "AlexF090",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexF090/eslint-plugin-unicode-comments.git"
  },
  "bugs": {
    "url": "https://github.com/AlexF090/eslint-plugin-unicode-comments/issues"
  },
  "homepage": "https://github.com/AlexF090/eslint-plugin-unicode-comments#readme",
  "peerDependencies": {
    "eslint": ">=8.40.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/**/*.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "^4.1.10"
  }
}
